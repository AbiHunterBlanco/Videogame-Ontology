        <rdf:type rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <owl:sameAs rdf:resource="https://dbpedia.org/page/Five_Nights_at_Freddy&apos;s#DBFiveNightsAtFreddys"/>
        <video-game-ontology:developedBy rdf:resource="http://example.org/ontologies/video-game-ontology#Scottgames"/>
        <video-game-ontology:hasGamemode rdf:resource="http://example.org/ontologies/video-game-ontology#Singleplayer"/>
