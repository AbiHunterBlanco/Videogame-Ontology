<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ontologies/video-game-ontology/"
     xml:base="http://example.org/ontologies/video-game-ontology/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:Helldivers="https://dbpedia.org/page/Helldivers#"
     xmlns:video-game-ontology="http://example.org/ontologies/video-game-ontology#">
    <owl:Ontology rdf:about="http://example.org/ontologies/video-game-ontology">
        <owl:imports rdf:resource="http://dbpedia.org/ontology/"/>
        <rdfs:comment>This is a video game ontology that models all relevant aspects of video games.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/ontologies/video-game-ontology#availableOn -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#availableOn">
        <owl:inverseOf rdf:resource="http://example.org/ontologies/video-game-ontology#hasGames"/>
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#Platform"/>
        <rdfs:comment>Platforms a game supports</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#competesIn -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#competesIn">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#EsportsPlayer"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#Competition"/>
        <rdfs:comment>Game an esports player competes in</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#developedBy -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#developedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#Developer"/>
        <rdfs:comment>Developer of the game</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#directedBy -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#directedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#Director"/>
        <rdfs:comment>Director of a game</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#distributedBy -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#distributedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#Distributor"/>
        <rdfs:comment>Distributor of game</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#hasGamemode -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#hasGamemode">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#Gamemode"/>
        <rdfs:comment>Links game to gamemode</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#hasGames -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#hasGames">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#Platform"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:comment>Entity has games associated with it</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#hasGenre -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#hasGenre">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#Genre"/>
        <rdfs:comment>Games genre</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#hasPerspective -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#hasPerspective">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#Perspective"/>
        <rdfs:comment>Player perspective in game</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#inFranchise -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#inFranchise">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#Franchise"/>
        <rdfs:comment>Links game to franchise</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#memberOf -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#memberOf">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#EsportsPlayer"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#EsportsTeam"/>
        <rdfs:comment>Team esports players are a part of</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#prequelOf -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#prequelOf">
        <owl:inverseOf rdf:resource="http://example.org/ontologies/video-game-ontology#sequelOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:comment>Game is prequel of another game</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#sequelOf -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#sequelOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:comment>Game is sequel of another game</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#similarTo -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#similarTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:comment>Links similar games</rdfs:comment>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/ontologies/video-game-ontology#similarTo"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
        <owl:annotatedTarget rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:comment>Symmetric</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://example.org/ontologies/video-game-ontology#streamsGame -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#streamsGame">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#Streamer"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:comment>What game a streamer has streamed</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#winsAward -->

    <owl:ObjectProperty rdf:about="http://example.org/ontologies/video-game-ontology#winsAward">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#AwardGroup"/>
        <rdfs:comment>Links game to awards won</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://dbpedia.org/page/Helldivers#basedOnGame -->

    <owl:ObjectProperty rdf:about="https://dbpedia.org/page/Helldivers#basedOnGame">
        <owl:inverseOf rdf:resource="https://dbpedia.org/page/Helldivers#hasMediaAdaptation"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://dbpedia.org/page/Arcane_(TV_series)#Media"/>
        <rdfs:comment>Media is based on a game</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://dbpedia.org/page/Helldivers#hasCompetition -->

    <owl:ObjectProperty rdf:about="https://dbpedia.org/page/Helldivers#hasCompetition">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/video-game-ontology#Competition"/>
        <rdfs:comment>Video game has competitions</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://dbpedia.org/page/Helldivers#hasMediaAdaptation -->

    <owl:ObjectProperty rdf:about="https://dbpedia.org/page/Helldivers#hasMediaAdaptation">
        <rdfs:range rdf:resource="https://dbpedia.org/page/Arcane_(TV_series)#Media"/>
        <rdfs:comment>Has a film or show based off of it</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/ontologies/video-game-ontology#actorName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#actorName">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VoiceActor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of voice actor</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#ageRating -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#ageRating">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#awardName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#awardName">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#AwardGroup"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Award game has won</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#characterName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#characterName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of video game character</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#competitionName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#competitionName">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#Competition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of Competition for video games</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#cosplayerName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#cosplayerName">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#Cosplayer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Cosplayer Name</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#description -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#description">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Describes game story</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#developerName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#developerName">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#Developer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of developer</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#directorName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#directorName">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#Director"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of games director</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#distributorName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#distributorName">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#Distributor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Distributor name</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#franchiseName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#franchiseName">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#Franchise"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of video game franchise</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#gameImage -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#gameImage">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#gameTitle -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#gameTitle">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of the game</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#gameTrailer -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#gameTrailer">
        <rdfs:comment>Trailer advertising the game</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#gamerName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#gamerName">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#Player"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Gamer name</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#highRAM -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#highRAM">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>High-End RAM specifications to run a game</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#highStorage -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#highStorage">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>High-End Storage Specifications to run a game</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#language -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#language">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Language game is in</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#numberOfPlayers -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#numberOfPlayers">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#playerRank -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#playerRank">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#EsportsPlayer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Global rank a player has in their video game</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#playerRating -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#playerRating">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Rating players have given based on how much they enjoy the game</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#price -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#price">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#recRAM -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#recRAM">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Recommended RAM to run a game</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#recStorage -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#recStorage">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Recommended Storage to run a game</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#region -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#region">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Region game can be played in</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#releaseDate -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#releaseDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Release Date of Game</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#streamerName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#streamerName">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#Streamer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of streamer</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/ontologies/video-game-ontology#teamName -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/video-game-ontology#teamName">
        <rdfs:domain rdf:resource="http://example.org/ontologies/video-game-ontology#EsportsTeam"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Esports team name</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/ontologies/video-game-ontology#AwardGroup -->

    <owl:Class rdf:about="http://example.org/ontologies/video-game-ontology#AwardGroup">
        <rdfs:subClassOf rdf:resource="http://example.org/ontologies/video-game-ontology#Organisation"/>
        <rdfs:comment>Organisation which gives awards to video games</rdfs:comment>
    </owl:Class>
    


    <!-- http://example.org/ontologies/video-game-ontology#Competition -->

    <owl:Class rdf:about="http://example.org/ontologies/video-game-ontology#Competition">
        <rdfs:comment>Video Game Competition where esports players compete in various games</rdfs:comment>
    </owl:Class>
    


    <!-- http://example.org/ontologies/video-game-ontology#Cosplayer -->

    <owl:Class rdf:about="http://example.org/ontologies/video-game-ontology#Cosplayer">
        <rdfs:subClassOf rdf:resource="http://example.org/ontologies/video-game-ontology#Person"/>
        <rdfs:comment>A user who recreates characters from games in real life</rdfs:comment>
    </owl:Class>
    


    <!-- http://example.org/ontologies/video-game-ontology#Critic -->

    <owl:Class rdf:about="http://example.org/ontologies/video-game-ontology#Critic">
        <rdfs:subClassOf rdf:resource="http://example.org/ontologies/video-game-ontology#Person"/>
