        <video-game-ontology:hasGenre rdf:resource="http://example.org/ontologies/video-game-ontology#Survival"/>
        <video-game-ontology:inFranchise rdf:resource="https://dbpedia.org/page/Five_Nights_at_Freddy&apos;s#FiveNightsAtFreddysFranchise"/>
        <video-game-ontology:prequelOf rdf:resource="http://example.org/ontologies/video-game-ontology#FiveNightsAtFreddys2"/>
        <Helldivers:hasMediaAdaptation rdf:resource="https://dbpedia.org/page/Five_Nights_at_Freddy&apos;s(Film)#FiveNightsAtFreddysFilm"/>
        <video-game-ontology:ageRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">13</video-game-ontology:ageRating>
        <video-game-ontology:description>From your small office you must watch the security cameras carefully. You have a very limited amount of electricity that you&apos;re allowed to use per night (corporate budget cuts, you know). That means when you run out of power for the night- no more security doors and no more lights! If something isn&apos;t right- namely if Freddybear or his friends aren&apos;t in their proper places, you must find them on the monitors and protect yourself if needed!</video-game-ontology:description>
        <video-game-ontology:gameImage rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://static.wikia.nocookie.net/venturiantale/images/d/d6/D89b9f4666be2a25d02a91d4cab8c639.jpg</video-game-ontology:gameImage>
        <video-game-ontology:gameTitle>FNAF</video-game-ontology:gameTitle>
        <video-game-ontology:gameTitle>Five Nights at Freddys</video-game-ontology:gameTitle>
        <video-game-ontology:gameTrailer rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.youtube.com/watch?v=RP4UTOek0-Y</video-game-ontology:gameTrailer>
        <video-game-ontology:language>English</video-game-ontology:language>
        <video-game-ontology:price rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</video-game-ontology:price>
        <video-game-ontology:recRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</video-game-ontology:recRAM>
        <video-game-ontology:recStorage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</video-game-ontology:recStorage>
        <rdfs:comment>Point and click horror game</rdfs:comment>
    </owl:NamedIndividual>
    


