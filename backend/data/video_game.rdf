    <!-- http://example.org/ontologies/video-game-ontology#FiveNightsAtFreddys2 -->

    <owl:NamedIndividual rdf:about="http://example.org/ontologies/video-game-ontology#FiveNightsAtFreddys2">
        <rdf:type rdf:resource="http://example.org/ontologies/video-game-ontology#VideoGame"/>
        <video-game-ontology:inFranchise rdf:resource="https://dbpedia.org/page/Five_Nights_at_Freddy&apos;s#FiveNightsAtFreddysFranchise"/>
        <video-game-ontology:developedBy rdf:resource="http://example.org/ontologies/video-game-ontology#Scottgames"/>
        <video-game-ontology:hasGamemode rdf:resource="http://example.org/ontologies/video-game-ontology#Singleplayer"/>
        <video-game-ontology:hasGenre rdf:resource="http://example.org/ontologies/video-game-ontology#Horror"/>
        <video-game-ontology:hasGenre rdf:resource="http://example.org/ontologies/video-game-ontology#Survival"/>
        <video-game-ontology:sequelOf rdf:resource="http://example.org/ontologies/video-game-ontology#FiveNightsAtFreddys"/>
        <video-game-ontology:ageRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">13</video-game-ontology:ageRating>
        <video-game-ontology:description>Welcome, Jeremy Fitzgerald, to your new summer job at the new and improved Freddy Fazbear&apos;s Pizza! Mike Schmidt requested to be moved to the day shift. He said something about the animatronic characters walking about and threatening him. Now, you may have heard some negative things about Freddy&apos;s but don&apos;t you worry! The building has been redesigned, the old characters have been given new software and there are all new characters so everything should be just fine!</video-game-ontology:description>
        <video-game-ontology:gameImage rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://m.media-amazon.com/images/M/MV5BNmM2MjIxYmItMDdhMC00ZjRkLTg0MDYtMzgzZjY5YzlmMTc0XkEyXkFqcGc@._V1_FMjpg_UX1000_.jpg</video-game-ontology:gameImage>
        <video-game-ontology:gameTitle>Five Nights At Freddys 2</video-game-ontology:gameTitle>
        <video-game-ontology:gameTrailer rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.youtube.com/watch?v=lVPONdZBh6s</video-game-ontology:gameTrailer>
        <video-game-ontology:language>English</video-game-ontology:language>
        <video-game-ontology:price rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</video-game-ontology:price>
        <rdfs:comment>Sequel to Five Nights At Freddys</rdfs:comment>
    </owl:NamedIndividual>
    


